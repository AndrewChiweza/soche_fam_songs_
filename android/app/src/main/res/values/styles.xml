<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Theme shown while Flutter initializes -->
    <style name="LaunchTheme" parent="Theme.Black.NoTitleBar">
        <!-- Background shown during launch -->
        <item name="android:windowBackground">@drawable/launch_background</item>

        <!-- ✅ THIS fixes recent apps icon -->
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>

        <!-- Use system white (no custom color needed) -->
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
    </style>

    <!-- Theme used after Flutter loads -->
    <style name="NormalTheme" parent="Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

</resources>
